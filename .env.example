# AItrans 模型提供商配置
#
# 推荐双击 aitrans.command（Windows：aitrans.bat），在「提供商」标签页里用图形界面配置；
# 也可以手工填写下面的变量。
# 翻译脚本优先读取 AI_* 变量；使用 DeepSeek 时，未设置 AI_* 会回退到旧版 DEEPSEEK_* 变量。

# 提供商标识（对应 providers.json 中的 id，仅用于管理）
AI_PROVIDER=deepseek
# 显示名称（会写入启动日志）
AI_PROVIDER_NAME=DeepSeek
# API Key；本地/自建且无需鉴权的服务可以留空
AI_API_KEY=your_api_key_here
# OpenAI 兼容接口地址（脚本会自动追加 /chat/completions）
AI_BASE_URL=https://api.deepseek.com
# 模型名称
AI_MODEL=deepseek-flash

# 可选：强制开启/关闭 DeepSeek 思考模式
# auto（默认）时仅 DeepSeek 域名自动关闭
# AI_THINKING=off

# 旧版兼容变量（上面的 AI_* 优先）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
