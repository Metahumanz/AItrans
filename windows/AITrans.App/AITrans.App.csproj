<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AITrans.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AITrans</AssemblyName>
    <ApplicationIcon>..\..\assets\icon\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AITrans.Core\AITrans.Core.csproj" />
  </ItemGroup>

  <!--
    dotnet publish 不会把 XAML 编译产物（.xbf 与应用的 .pri）带进发布目录。
    缺了它们，发布版启动时会在 Microsoft.UI.Xaml.dll 里以 0xC000027B 崩溃，
    而 bin/ 下的构建产物却正常。这里在发布完成后把它们补进去。
  -->
  <Target Name="CopyWinUIXamlResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIXamlResource Include="$(TargetDir)**\*.xbf" />
      <_WinUIXamlResource Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIXamlResource)"
          DestinationFiles="@(_WinUIXamlResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
